# 使用服务商提供的 OpenAI 兼容接口配置。
OPENAI_API_KEY=your_api_key
OPENAI_API_BASE=https://your-provider.example/compatible-mode/v1
OPENAI_MODEL=your_model_name

# 项目独立的本地 Redis 8.2，包含 JSON + Search（scripts/start_redis.py）。
REDIS_URL=redis://127.0.0.1:6380/0

# PostgreSQL 数据库需提前创建，并手动执行 backend/sql/ 下的建表脚本。
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/echomind_db
